<%- include('partials/header', { title: 'การต่อสู้', player: player }) %>

<%
  const isBoss    = typeof monster !== 'undefined' && monster && monster.is_boss;
  const monsterHp = typeof monster !== 'undefined' && monster ? monster.hp : 100;
  const monsterMaxHp = typeof monster !== 'undefined' && monster ? monster.max_hp : 100;
  const question  = typeof currentQuestion !== 'undefined' ? currentQuestion : null;
%>

<div class="container--wide" style="padding-top: 28px; padding-bottom: 60px;">
  <div class="flex gap-lg" style="align-items: flex-start;">

    <!-- SIDEBAR -->
    <%- include('partials/hide-sidebar', {
      player: player,
      quickItems: typeof quickItems !== 'undefined' ? quickItems : []
    }) %>

    <!-- COMBAT MAIN -->
    <div style="flex:1; min-width:0;">

      <!-- Boss Banner -->
      <% if (isBoss) { %>
      <div class="panel" style="text-align:center; padding: 12px; margin-bottom: 16px;
                                border-color: var(--blood); background: rgba(139,26,26,0.12);
                                animation: badgePulse 1.5s infinite;">
        <span class="badge badge--boss" style="font-size: 13px; padding: 6px 16px;">
          ⚠️ FINAL BOSS BATTLE ⚠️
        </span>
      </div>
      <% } %>

      <!-- ARENA -->
      <div class="panel panel--gold animate-fadein" style="margin-bottom: 16px;">
        <div class="combat-arena" style="padding: 24px 32px; gap: 0;">

          <!-- Player Side -->
          <div style="text-align:center;">
            <div class="section-label mb-sm">ผู้เล่น</div>
            <div class="fighter-sprite" id="playerSprite"><%= player.avatar || '🧙' %></div>
            <div class="text-gold mt-sm" style="font-family:var(--font-display); font-size:13px; letter-spacing:2px;">
              <%= player.username %>
            </div>
            <div class="stat-wrap mt-sm">
              <div class="stat-label-row">
                <span>❤️ HP</span>
                <span id="playerHpText"><%= player.hp %>/<%= player.max_hp %></span>
              </div>
              <div class="stat-bar">
                <div class="stat-bar__fill stat-bar__fill--hp" id="playerHpBar"
                     style="width:<%= Math.round(player.hp/player.max_hp*100) %>%"></div>
              </div>
            </div>
            <div class="stat-wrap mt-sm">
              <div class="stat-label-row">
                <span>💧 MP</span>
                <span id="playerMpText"><%= player.mp %>/<%= player.max_mp %></span>
              </div>
              <div class="stat-bar">
                <div class="stat-bar__fill stat-bar__fill--mp" id="playerMpBar"
                     style="width:<%= Math.round(player.mp/player.max_mp*100) %>%"></div>
              </div>
            </div>
          </div>

          <!-- VS -->
          <div style="display:flex; align-items:center; justify-content:center;">
            <div style="font-family:var(--font-display); color:var(--blood-light);
                        font-size: clamp(24px,4vw,40px); font-weight:900; letter-spacing:4px;
                        text-shadow: 0 0 20px rgba(196,48,48,0.5);">VS</div>
          </div>

          <!-- Monster Side -->
          <% if (typeof monster !== 'undefined' && monster) { %>
          <div style="text-align:center;">
            <div class="section-label mb-sm">
              <% if (isBoss) { %><span style="color:var(--blood-light);">⚠️ บอส</span><% } else { %>ศัตรู<% } %>
            </div>
            <div class="fighter-sprite" id="monsterSprite"
                 style="<%= isBoss ? 'filter: drop-shadow(0 10px 30px rgba(196,48,48,0.6));' : '' %>">
              <%= monster.sprite || '👹' %>
            </div>
            <div class="text-gold mt-sm" style="font-family:var(--font-display); font-size:13px; letter-spacing:2px;">
              <%= monster.name || 'มอนสเตอร์' %>
            </div>
            <% if (monster.difficulty) { %>
            <span class="badge badge--<%= monster.difficulty %> mt-sm"><%= monster.difficulty %></span>
            <% } %>
            <div class="stat-wrap mt-sm">
              <div class="stat-label-row">
                <span>💀 HP</span>
                <span id="monsterHpText"><%= monsterHp %>/<%= monsterMaxHp %></span>
              </div>
              <div class="stat-bar">
                <div class="stat-bar__fill stat-bar__fill--hp" id="monsterHpBar"
                     style="width:<%= Math.round(monsterHp/monsterMaxHp*100) %>%; background: linear-gradient(90deg,#4a0a0a,#8b1a1a);"></div>
              </div>
            </div>
          </div>
          <% } %>

        </div><!-- end combat-arena -->
      </div>

      <!-- TURN INDICATOR -->
      <div class="text-center mb-md animate-fadein">
        <span class="badge badge--gold" id="turnBadge" style="font-size: 12px; padding: 6px 18px;">
          🎯 รอบที่ <%= typeof turnCount !== 'undefined' ? turnCount : 1 %> — เลือกคำตอบ
        </span>
      </div>

      <!-- QUESTION PANEL -->
      <% if (question) { %>
      <div class="panel panel--ornate animate-fadeinup" style="margin-bottom: 16px;" id="questionPanel">
        <div class="panel-header">
          <span class="panel-title">📖 คำถาม</span>
          <div class="flex gap-sm items-center">
            <% if (question.category) { %>
            <span class="badge badge--info"><%= question.category %></span>
            <% } %>
            <% if (question.difficulty) { %>
            <span class="badge badge--<%= question.difficulty %>"><%= question.difficulty %></span>
            <% } %>
            <!-- Timer -->
            <span class="text-mono text-small" id="timerDisplay" style="color: var(--gold);">⏱ 30s</span>
          </div>
        </div>
        <div class="panel-body">
          <p style="font-size: 17px; color: var(--parchment); margin-bottom: 20px; line-height: 1.7;">
            <%= question.question_text %>
          </p>

          <!-- Answer Options -->
          <div style="display: flex; flex-direction: column; gap: 8px;" id="optionsContainer">
            <% const opts = ['A','B','C','D']; %>
            <% const choices = [question.option_a, question.option_b, question.option_c, question.option_d]; %>
            <% choices.forEach((choice, i) => { %>
            <% if (choice) { %>
            <button class="quiz-option" data-answer="<%= opts[i] %>"
                    onclick="selectAnswer('<%= opts[i] %>', this)">
              <span class="option-key"><%= opts[i] %>.</span>
              <%= choice %>
            </button>
            <% } %>
            <% }) %>
          </div>

          <!-- Skill / Item Buttons -->
          <div class="flex gap-sm mt-md flex-wrap" id="skillBar">
            <% if (typeof skills !== 'undefined' && skills) { %>
              <% if (skills.canEliminate && player.mp >= 10) { %>
              <button class="btn btn--sm" onclick="useSkill('eliminate')" id="btnEliminate"
                      title="ตัดตัวเลือกผิด 2 ข้อ (ใช้ 10 MP)">
                ✂️ ตัดตัวเลือก <span class="badge badge--info">10 MP</span>
              </button>
              <% } %>
              <% if (skills.canShield && player.mp >= 15) { %>
              <button class="btn btn--sm" onclick="useSkill('shield')" id="btnShield"
                      title="ป้องกันดาเมจจากการตอบผิด 1 ครั้ง (ใช้ 15 MP)">
                🛡️ ป้องกัน <span class="badge badge--info">15 MP</span>
              </button>
              <% } %>
            <% } %>
          </div>
        </div>
      </div>
      <% } else { %>
      <div class="panel text-center" style="padding: 40px;">
        <p class="text-dim">ไม่พบคำถาม — กำลังโหลด...</p>
      </div>
      <% } %>

      <!-- COMBAT LOG -->
      <div class="panel animate-fadeinup delay-2">
        <div class="panel-header">
          <span class="panel-title">⚔️ บันทึกการต่อสู้</span>
        </div>
        <div class="panel-body" style="padding:0;">
          <div class="event-log" id="combatLog">
            <div class="log-entry log-entry--system">⚔️ การต่อสู้เริ่มต้นแล้ว! ตอบคำถามเพื่อโจมตีศัตรู</div>
            <% if (typeof combatLog !== 'undefined' && combatLog) { %>
              <% combatLog.forEach(entry => { %>
              <div class="log-entry log-entry--<%= entry.type || 'info' %>"><%= entry.message %></div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>

    </div><!-- end combat main -->
  </div>
</div>

<!-- Damage Float Template -->
<div id="damageFloat" style="position:fixed; pointer-events:none; font-family:var(--font-display);
     font-size: 32px; font-weight:900; z-index:9000; display:none;"></div>

<script>
  let timerInterval = null;
  let timeLeft = 30;
  let shieldActive = false;

  // ===== TIMER =====
  function startTimer() {
    clearInterval(timerInterval);
    timeLeft = 30;
    updateTimerDisplay();
    timerInterval = setInterval(() => {
      timeLeft--;
      updateTimerDisplay();
      if (timeLeft <= 0) {
        clearInterval(timerInterval);
        autoWrongAnswer();
      }
    }, 1000);
  }

  function updateTimerDisplay() {
    const el = document.getElementById('timerDisplay');
    if (!el) return;
    el.textContent = `⏱ ${timeLeft}s`;
    if (timeLeft <= 10) el.style.animation = 'timerUrgent 1s infinite';
    else el.style.animation = '';
  }

  // ===== SELECT ANSWER =====
  async function selectAnswer(key, btn) {
    clearInterval(timerInterval);
    disableAllOptions();

    try {
      const res  = await fetch('/game/answer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ answer: key, shieldActive })
      });
      const data = await res.json();

      if (data.correct) {
        btn.classList.add('is-correct');
        showDamage(`-${data.damage || 0} 💥`, 'monsterSprite', '#70e0a0');
        addCombatLog(`✅ ถูกต้อง! โจมตีศัตรู ${data.damage || 0} ความเสียหาย`, 'success');
        updateMonsterHp(data.monsterHp, data.monsterMaxHp);
      } else {
        btn.classList.add('is-wrong');
        // Show correct answer
        document.querySelectorAll('.quiz-option').forEach(b => {
          if (b.dataset.answer === data.correctAnswer) b.classList.add('is-correct');
        });
        if (!shieldActive) {
          document.getElementById('playerSprite').classList.add('animate-shake','flash-red');
          showDamage(`-${data.dmgReceived || 0} 💔`, 'playerSprite', '#e08080');
          addCombatLog(`❌ ผิด! รับความเสียหาย ${data.dmgReceived || 0}`, 'danger');
          updatePlayerHp(data.playerHp, data.playerMaxHp);
          setTimeout(() => {
            document.getElementById('playerSprite').classList.remove('animate-shake','flash-red');
          }, 600);
        } else {
          addCombatLog('🛡️ ป้องกันสำเร็จ! ไม่รับดาเมจครั้งนี้', 'info');
          shieldActive = false;
        }
      }

      // Check win/lose
      if (data.redirect) {
        setTimeout(() => { window.location.href = data.redirect; }, 1500);
      } else if (!data.gameOver) {
        setTimeout(() => { window.location.reload(); }, 1800);
      }
    } catch(e) {
      addCombatLog('⚠️ เกิดข้อผิดพลาด กรุณาลองใหม่', 'danger');
      enableAllOptions();
    }
  }

  function autoWrongAnswer() {
    addCombatLog('⏰ หมดเวลา! รับความเสียหายจากมอนสเตอร์', 'danger');
    selectAnswer('__timeout__', { classList: { add: () => {} }, dataset: { answer: '__timeout__' } });
  }

  // ===== SKILLS =====
  async function useSkill(type) {
    const res  = await fetch('/game/use-skill', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ skill: type })
    });
    const data = await res.json();
    if (!data.success) { addCombatLog('⚠️ ' + (data.message || 'ใช้ทักษะไม่ได้'), 'danger'); return; }

    if (type === 'eliminate') {
      let eliminated = 0;
      document.querySelectorAll('.quiz-option').forEach(btn => {
        if (eliminated < 2 && btn.dataset.answer !== data.correctAnswer && !btn.disabled) {
          btn.classList.add('is-disabled');
          eliminated++;
        }
      });
      document.getElementById('btnEliminate').disabled = true;
      addCombatLog('✂️ ตัดตัวเลือกผิด 2 ข้อ (-10 MP)', 'info');
    } else if (type === 'shield') {
      shieldActive = true;
      document.getElementById('btnShield').disabled = true;
      addCombatLog('🛡️ เปิดใช้งานโล่ป้องกัน (-15 MP)', 'info');
    }
    updatePlayerMp(data.playerMp, data.playerMaxMp);
  }

  // ===== HELPERS =====
  function disableAllOptions() {
    document.querySelectorAll('.quiz-option').forEach(b => b.classList.add('is-disabled'));
  }
  function enableAllOptions() {
    document.querySelectorAll('.quiz-option').forEach(b => b.classList.remove('is-disabled'));
  }

  function updatePlayerHp(hp, max) {
    document.getElementById('playerHpText').textContent = `${hp}/${max}`;
    document.getElementById('playerHpBar').style.width = `${Math.max(0, Math.round(hp/max*100))}%`;
  }
  function updatePlayerMp(mp, max) {
    document.getElementById('playerMpText').textContent = `${mp}/${max}`;
    document.getElementById('playerMpBar').style.width = `${Math.max(0, Math.round(mp/max*100))}%`;
  }
  function updateMonsterHp(hp, max) {
    document.getElementById('monsterHpText').textContent = `${hp}/${max}`;
    document.getElementById('monsterHpBar').style.width = `${Math.max(0, Math.round(hp/max*100))}%`;
  }

  function showDamage(text, targetId, color) {
    const target = document.getElementById(targetId);
    if (!target) return;
    const rect = target.getBoundingClientRect();
    const el   = document.getElementById('damageFloat');
    el.textContent = text;
    el.style.color = color;
    el.style.left  = `${rect.left + rect.width/2 - 40}px`;
    el.style.top   = `${rect.top + window.scrollY - 20}px`;
    el.style.display = 'block';
    el.style.animation = 'floatUp 1s ease-out forwards';
    setTimeout(() => { el.style.display = 'none'; el.style.animation = ''; }, 1100);
  }

  function addCombatLog(msg, type = 'info') {
    const log = document.getElementById('combatLog');
    const div = document.createElement('div');
    div.className = `log-entry log-entry--${type} animate-fadein`;
    div.textContent = msg;
    log.prepend(div);
  }

  // Start timer on load
  startTimer();
</script>

<%- include('partials/footer', { extraScript: 'combat' }) %>
