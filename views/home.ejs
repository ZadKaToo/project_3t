<%- include('partials/header', { title: 'หน้าแรก', player: player }) %>

<!-- ====== HERO ====== -->
<section style="text-align:center; padding: 80px 24px 60px;">
  <div class="ornament animate-fadein">✦ ✦ ✦</div>
  <h1 class="hero-title animate-fadeinup delay-1">DUNGEON<br>SCHOLAR</h1>
  <p class="hero-sub animate-fadeinup delay-2">ทดสอบความรู้ · ผจญภัยในดันเจี้ยน · เอาชนะมอนสเตอร์</p>
  <div class="ornament animate-fadein delay-3">✦ ✦ ✦</div>
</section>

<!-- ====== MAIN MENU ====== -->
<div class="container" style="padding-bottom: 80px;">

  <% if (typeof player !== 'undefined' && player) { %>
  <!-- ===== มี session: แสดง Player Dashboard ===== -->

  <!-- Player Status Card -->
  <div class="panel panel--gold panel--ornate animate-fadeinup" style="margin-bottom: 32px; max-width: 560px; margin-left: auto; margin-right: auto;">
    <div class="panel-header">
      <span class="panel-title">สถานะนักผจญภัย</span>
      <span class="badge badge--gold">LV.<%= player.level || 1 %></span>
    </div>
    <div class="panel-body">
      <div class="flex items-center gap-md">
        <div style="font-size:52px;"><%= player.avatar || '🧙' %></div>
        <div style="flex:1;">
          <div class="text-gold" style="font-family: var(--font-display); font-size: 18px; letter-spacing: 3px;">
            <%= player.username %>
          </div>
          <div class="text-mono text-small mt-sm" style="color: var(--gold-dim);">
            📍 <%= player.current_location || 'Village' %> &nbsp;|&nbsp; 💰 <%= player.gold || 0 %> Gold
          </div>
          <div style="margin-top: 12px;">
            <div class="stat-wrap mb-sm">
              <div class="stat-label-row">
                <span>❤️ HP</span><span><%= player.hp %>/<%= player.max_hp %></span>
              </div>
              <div class="stat-bar">
                <div class="stat-bar__fill stat-bar__fill--hp"
                     style="width: <%= Math.round(player.hp/player.max_hp*100) %>%"></div>
              </div>
            </div>
            <div class="stat-wrap">
              <div class="stat-label-row">
                <span>💧 MP</span><span><%= player.mp %>/<%= player.max_mp %></span>
              </div>
              <div class="stat-bar">
                <div class="stat-bar__fill stat-bar__fill--mp"
                     style="width: <%= Math.round(player.mp/player.max_mp*100) %>%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="flex justify-center gap-md flex-wrap animate-fadeinup delay-2">
    <a href="/game/map" class="btn btn--lg">🗺️ ผจญภัยต่อ</a>
    <a href="/game/save" class="btn btn--ghost">💾 โหลด / บันทึก</a>
    <a href="/leaderboard" class="btn btn--ghost">🏆 กระดานคะแนน</a>
    <a href="/auth/logout" class="btn btn--danger btn--sm">ออกจากระบบ</a>
  </div>

  <% } else { %>
  <!-- ===== ยังไม่ login: แสดง Landing ===== -->

  <!-- CTA Buttons -->
  <div class="flex justify-center gap-md flex-wrap animate-fadeinup delay-2" style="margin-bottom: 60px;">
    <a href="/auth/register" class="btn btn--lg">⚔️ เริ่มการผจญภัย</a>
    <a href="/auth/login" class="btn btn--ghost btn--lg">🔑 เข้าสู่ระบบ</a>
  </div>

  <!-- Feature Cards -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">

    <div class="panel animate-fadeinup delay-1" style="padding: 24px; text-align:center;">
      <div style="font-size: 40px; margin-bottom: 12px;">🎲</div>
      <h3 style="margin-bottom: 8px;">ทอยลูกเต๋า</h3>
      <p class="text-small text-dim">เคลื่อนที่บนแผนที่แบบสุ่ม พบเหตุการณ์และมอนสเตอร์ที่ไม่คาดฝัน</p>
    </div>

    <div class="panel animate-fadeinup delay-2" style="padding: 24px; text-align:center;">
      <div style="font-size: 40px; margin-bottom: 12px;">⚔️</div>
      <h3 style="margin-bottom: 8px;">ต่อสู้ด้วยความรู้</h3>
      <p class="text-small text-dim">ตอบคำถามให้ถูกต้องเพื่อโจมตี ตอบผิดแล้วรับดาเมจจากศัตรู</p>
    </div>

    <div class="panel animate-fadeinup delay-3" style="padding: 24px; text-align:center;">
      <div style="font-size: 40px; margin-bottom: 12px;">🏆</div>
      <h3 style="margin-bottom: 8px;">สะสมรางวัล</h3>
      <p class="text-small text-dim">เก็บ Gold, ไอเทม, และอุปกรณ์เสริมพลัง พร้อมลุยบอสสุดท้าย</p>
    </div>

  </div>
  <% } %>

  <!-- Leaderboard Preview -->
  <% if (typeof leaderboard !== 'undefined' && leaderboard && leaderboard.length > 0) { %>
  <div class="panel mt-lg animate-fadeinup">
    <div class="panel-header">
      <span class="panel-title">🏆 กระดานคะแนนสูงสุด</span>
      <a href="/leaderboard" class="btn btn--sm btn--ghost">ดูทั้งหมด</a>
    </div>
    <div class="panel-body" style="padding: 0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>#</th><th>ผู้เล่น</th><th>คะแนน</th><th>ชนะ</th>
          </tr>
        </thead>
        <tbody>
          <% leaderboard.slice(0, 5).forEach((row, i) => { %>
          <tr>
            <td class="rank-<%= i+1 %> text-mono"><%= i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : i+1 %></td>
            <td><%= row.avatar || '🧙' %> <%= row.username %></td>
            <td class="text-gold text-mono"><%= row.total_score || 0 %></td>
            <td class="text-mono text-small"><%= row.wins || 0 %> ครั้ง</td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

</div>

<%- include('partials/footer') %>
