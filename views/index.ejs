<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen flex flex-col relative overflow-x-hidden">
    <%- include('partials/header') %>
    
    <%- include('partials/inventorySidebar') %>

    <main class="flex-grow flex items-center justify-center p-6 z-10 relative">
        <div class="bg-dnd-panel p-8 rounded-lg shadow-xl max-w-md w-full border border-gray-700 text-center relative z-20">
            <h1 class="text-3xl font-bold text-dnd-accent mb-6">ยินดีต้อนรับนักผจญภัย</h1>
            
            <div class="flex flex-col space-y-4">
                <a href="/start-game" class="bg-blue-600 hover:bg-blue-500 text-white py-3 rounded-md font-bold transition">
                    <i class="fa-solid fa-play mr-2"></i> เริ่มการเดินทาง
                </a>
                
                <a href="/load-save" class="bg-gray-700 hover:bg-gray-600 text-white py-3 rounded-md transition">
                    <i class="fa-solid fa-floppy-disk mr-2"></i> โหลดข้อมูล
                </a>
                
                <button onclick="toggleSidebar()" class="bg-gray-700 hover:bg-gray-600 text-white py-3 rounded-md transition">
                    <i class="fa-solid fa-sack-dollar mr-2"></i> กระเป๋าไอเทม (Inventory)
                </button>

                <a href="/setting" class="bg-gray-700 hover:bg-gray-600 text-white py-3 rounded-md transition">
                    <i class="fa-solid fa-gear mr-2"></i> ตั้งค่าระบบ
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('inventorySidebar');
            if (sidebar) {
                sidebar.classList.toggle('translate-x-full');
            } else {
                alert("เกิดข้อผิดพลาด: หาตัวกระเป๋าไอเทมไม่เจอ โปรดเช็คการ include ไฟล์");
                console.error("หา id 'inventorySidebar' ไม่เจอครับ!");
            }
        }
    </script>
</body>
</html>