<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('partials/head') %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&display=swap');

        /* แถบเหรียญทองแบบเรืองแสง */
        .gold-display {
            background: linear-gradient(135deg, #c8a84b 0%, #8a6d1d 100%);
            box-shadow: 0 0 15px rgba(200, 168, 75, 0.3);
            text-shadow: 0 1px 2px rgba(0,0,0,0.5);
        }

        /* การ์ดไอเทมสไตล์ Souls */
        .shop-card {
            background: rgba(20, 18, 24, 0.8);
            border: 1px solid #3a3442;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .shop-card:hover {
            border-color: #c8a84b;
            background: rgba(30, 28, 38, 0.9);
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        }

        /* ปุ่มซื้อ */
        .buy-btn {
            background: #1a161f;
            border: 1px solid #4a4056;
            color: #c8a84b;
            transition: all 0.3s ease;
        }
        .buy-btn:hover:not(:disabled) {
            background: #c8a84b;
            color: #1a161f;
            box-shadow: 0 0 10px rgba(200, 168, 75, 0.4);
        }

        /* รายการในกระเป๋า */
        .inventory-item {
            border-left: 2px solid #4a4056;
            background: rgba(255,255,255,0.03);
        }

        .ancient-font {
            font-family: 'UnifrakturMaguntia', serif;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-black text-gray-400">
    <%- include('partials/header') %>

    <main class="flex-grow container mx-auto p-4 md:p-8 flex flex-col md:flex-row gap-8 mt-4">
        
        <div class="w-full md:w-2/3 bg-gray-900/40 p-8 rounded-lg shadow-2xl border border-gray-800 relative overflow-hidden">
            <div class="absolute top-0 right-0 p-4 opacity-5 pointer-events-none">
                <i class="fa-solid fa-scroll text-9xl"></i>
            </div>

            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-gray-800 pb-6 mb-8 gap-4">
                <div>
                    <h2 class="text-4xl font-bold text-white ancient-font tracking-wider">
                        <i class="fa-solid fa-store mr-3 text-gray-600"></i>Mystery Merchant
                    </h2>
                    <p class="text-sm text-gray-500 mt-1 italic">"เหรียญทองของเจ้า... แลกกับลมหายใจที่ยืนยาวขึ้นได้นะ"</p>
                </div>
                <div class="gold-display text-black px-6 py-2 rounded-sm font-bold flex items-center gap-3">
                    <i class="fa-solid fa-coins animate-bounce"></i>
                    <span id="playerGold" class="text-xl"><%= player.gold %></span>
                    <span class="text-xs uppercase tracking-tighter">Gold</span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <% if (shopItems && shopItems.length > 0) { %>
                    <% shopItems.forEach(item => { %>
                        <div class="shop-card p-5 rounded-sm flex flex-col justify-between group">
                            <div>
                                <div class="flex justify-between items-start mb-3">
                                    <h3 class="text-xl font-bold text-gray-200 group-hover:text-white transition-colors">
                                        <% if (item.type === 'heal') { %><i class="fa-solid fa-flask text-red-900 mr-2"></i><% } %>
                                        <% if (item.type === 'weapon') { %><i class="fa-solid fa-sword text-gray-700 mr-2"></i><% } %>
                                        <%= item.name %>
                                    </h3>
                                    <span class="text-xs text-gray-600 font-mono">ID: <%= item.item_id %></span>
                                </div>
                                <p class="text-sm text-gray-500 mb-4 h-10 overflow-hidden leading-relaxed"><%= item.description %></p>
                                <div class="flex items-center gap-2 mb-6">
                                    <span class="text-[10px] uppercase tracking-widest text-gray-600">Effect:</span>
                                    <span class="text-xs text-green-900 font-bold">+<%= item.effect_value %> <%= item.type %></span>
                                </div>
                            </div>
                            
                            <button onclick="buyItem('<%= item.item_id %>', <%= item.price %>)" 
                                    class="buy-btn w-full py-3 font-bold uppercase tracking-widest text-xs flex justify-center items-center gap-2">
                                <span>Purchase</span>
                                <span class="opacity-40">|</span>
                                <span><%= item.price %> G</span>
                            </button>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-2 text-center py-20 border border-dashed border-gray-800 rounded">
                        <i class="fa-solid fa-ghost text-5xl mb-4 text-gray-800"></i>
                        <p class="ancient-font text-2xl text-gray-700">The shelves are bare...</p>
                        <p class="text-xs text-gray-600 mt-2">ไม่มีสินค้าเหลืออยู่ มีเพียงความว่างเปล่า</p>
                    </div>
                <% } %>
            </div>

            <div class="mt-10 pt-6 border-t border-gray-800">
                <a href="/map" class="text-xs uppercase tracking-[0.3em] text-gray-500 hover:text-white transition-all flex items-center gap-3">
                    <i class="fa-solid fa-chevron-left"></i> Leave the shop
                </a>
            </div>
        </div>

        <div class="w-full md:w-1/3 flex flex-col gap-6">
            <div class="bg-gray-900/20 p-6 rounded-lg border border-gray-800 shadow-xl">
                <h3 class="text-sm uppercase tracking-[0.2em] text-gray-200 mb-6 flex items-center justify-between">
                    <span>Inventory</span>
                    <i class="fa-solid fa-briefcase text-gray-700"></i>
                </h3>
                
                <ul id="inventoryList" class="space-y-3 max-h-[400px] overflow-y-auto pr-2 custom-scrollbar">
                    <% if (inventory && inventory.length > 0) { %>
                        <% inventory.forEach(inv => { %>
                            <li class="inventory-item flex justify-between items-center p-3 text-sm">
                                <span class="text-gray-300 font-light"><%= inv.name %></span>
                                <span class="text-xs text-gray-500 font-mono bg-gray-800/50 px-2 py-1">x<%= inv.quantity %></span>
                            </li>
                        <% }) %>
                    <% } else { %>
                        <li class="text-gray-700 text-sm italic py-4 text-center">"กระเป๋าว่างเปล่า... ช่างน่าเวทนา"</li>
                    <% } %>
                </ul>
                
                <div class="mt-6 p-4 bg-yellow-900/5 border border-yellow-900/10 rounded">
                    <p class="text-[10px] leading-relaxed text-yellow-800/60 uppercase tracking-wider">
                        * สินค้าที่ซื้อจะถูกส่งเข้ากระเป๋าทันที <br> โปรดตรวจสอบความเรียบร้อยก่อนออกเดินทาง
                    </p>
                </div>
            </div>
        </div>

    </main>

    <%- include('partials/footer') %>

    <script>
        async function buyItem(itemId, price) {
            const currentGold = parseInt(document.getElementById('playerGold').innerText);

            if (currentGold < price) {
                // เปลี่ยน alert เป็นแบบนุ่มนวลขึ้น
                showNotification('Gold ของเจ้าไม่เพียงพอ...', 'error');
                return;
            }

            try {
                const response = await fetch('/shop/buy', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ item_id: itemId })
                });

                const data = await response.json();

                if (data.success) {
                    document.getElementById('playerGold').innerText = data.newGold;
                    // แสดงผลสำเร็จและรีโหลด
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    alert('Merchant says: ' + data.message);
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }

        // ฟังก์ชันช่วยแสดง Alert แบบง่าย (ถ้ามีระบบ notification เดิมอยู่แล้วให้ตัดออก)
        function showNotification(msg, type) {
            alert(msg); 
        }
    </script>
</body>
</html>