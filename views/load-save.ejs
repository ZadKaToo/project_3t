<%- include('partials/header', { title: 'บันทึก / โหลด', player: player }) %>

<div class="container" style="padding-top: 40px; padding-bottom: 80px; max-width: 720px;">

  <div class="text-center mb-lg animate-fadeinup">
    <div class="section-label">Game Progress</div>
    <h2>💾 บันทึก & โหลดเกม</h2>
  </div>

  <!-- ===== SAVE SLOTS ===== -->
  <div style="display: flex; flex-direction: column; gap: 16px;">

    <% const slots = typeof saveSlots !== 'undefined' ? saveSlots : [null, null, null]; %>
    <% slots.forEach((slot, i) => { %>

    <div class="panel panel--ornate animate-fadeinup delay-<%= i+1 %>">
      <div class="panel-header">
        <span class="panel-title">Slot <%= i + 1 %></span>
        <% if (slot) { %>
          <span class="badge badge--gold">LV.<%= slot.level || 1 %></span>
        <% } else { %>
          <span class="badge" style="border-color: var(--stone-lighter); color: var(--stone-lighter);">ว่าง</span>
        <% } %>
      </div>

      <div class="panel-body">
        <% if (slot) { %>
        <!-- Slot มีข้อมูล -->
        <div class="flex items-center gap-md">
          <div style="font-size: 40px;"><%= slot.avatar || '🧙' %></div>
          <div style="flex:1;">
            <div class="text-gold" style="font-family: var(--font-display); letter-spacing: 2px;">
              <%= slot.username %>
            </div>
            <div class="flex gap-md mt-sm flex-wrap">
              <span class="text-mono text-small">❤️ HP <%= slot.hp %>/<%= slot.max_hp %></span>
              <span class="text-mono text-small">💰 <%= slot.gold %> Gold</span>
              <span class="text-mono text-small">📍 <%= slot.current_location || 'Village' %></span>
            </div>
            <div class="text-mono text-small mt-sm" style="color: var(--stone-lighter);">
              บันทึกล่าสุด: <%= slot.saved_at ? new Date(slot.saved_at).toLocaleString('th-TH') : '—' %>
            </div>
          </div>
          <div class="flex flex-col gap-sm">
            <form action="/game/load" method="POST" style="display:inline;">
              <input type="hidden" name="slot" value="<%= i + 1 %>">
              <button type="submit" class="btn btn--sm btn--success">▶ โหลด</button>
            </form>
            <form action="/game/save" method="POST" style="display:inline;">
              <input type="hidden" name="slot" value="<%= i + 1 %>">
              <button type="submit" class="btn btn--sm">💾 เขียนทับ</button>
            </form>
            <form action="/game/delete-save" method="POST" style="display:inline;"
                  onsubmit="return confirm('ลบข้อมูล Slot <%= i+1 %> จริงหรือ?')">
              <input type="hidden" name="slot" value="<%= i + 1 %>">
              <button type="submit" class="btn btn--sm btn--danger">🗑 ลบ</button>
            </form>
          </div>
        </div>

        <% } else { %>
        <!-- Slot ว่าง -->
        <div class="flex items-center justify-between">
          <span class="text-dim text-small">— ไม่มีข้อมูล —</span>
          <form action="/game/save" method="POST">
            <input type="hidden" name="slot" value="<%= i + 1 %>">
            <button type="submit" class="btn btn--sm">💾 บันทึกที่ Slot นี้</button>
          </form>
        </div>
        <% } %>
      </div>
    </div>

    <% }) %>
  </div>

  <!-- ===== GAME HISTORY ===== -->
  <% if (typeof history !== 'undefined' && history && history.length > 0) { %>
  <div class="panel mt-lg animate-fadeinup">
    <div class="panel-header">
      <span class="panel-title">📜 ประวัติการเล่น</span>
    </div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>วันที่</th><th>คะแนน</th><th>ถูก</th><th>ผิด</th><th>ผลลัพธ์</th>
          </tr>
        </thead>
        <tbody>
          <% history.slice(0, 10).forEach(h => { %>
          <tr>
            <td class="text-mono text-small"><%= new Date(h.played_at).toLocaleDateString('th-TH') %></td>
            <td class="text-gold text-mono"><%= h.score || 0 %></td>
            <td class="text-success text-mono"><%= h.correct || 0 %></td>
            <td class="text-danger text-mono"><%= h.wrong || 0 %></td>
            <td>
              <span class="badge <%= h.result === 'victory' ? 'badge--success' : 'badge--danger' %>">
                <%= h.result === 'victory' ? 'ชนะ' : 'แพ้' %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <div class="text-center mt-lg">
    <a href="/" class="btn btn--ghost">← กลับหน้าหลัก</a>
  </div>

</div>

<%- include('partials/footer') %>
