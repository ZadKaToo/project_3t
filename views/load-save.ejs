<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen flex flex-col relative overflow-x-hidden text-gray-200">
    
    <%- include('partials/header', { title: 'บันทึก / โหลด', player: player }) %>
    
    <%- include('partials/inventorySidebar') %>

    <main class="flex-grow flex flex-col items-center justify-start p-6 z-10 relative">
        <div class="w-full max-w-4xl space-y-8">
            
            <div class="text-center mb-8 animate-fade-in-up mt-4">
                <div class="text-yellow-500 tracking-widest text-sm uppercase font-bold mb-2">Game Progress</div>
                <h2 class="text-3xl md:text-4xl font-bold text-white shadow-black drop-shadow-lg">
                    <i class="fa-solid fa-floppy-disk mr-2"></i> บันทึก & โหลดเกม
                </h2>
            </div>

            <div class="space-y-6">
                <% (typeof saveSlots !== 'undefined' ? saveSlots : [null, null, null]).forEach((slot, i) => { %>
                    
                    <div class="bg-dnd-panel border <%= slot ? 'border-yellow-600/50 hover:border-yellow-500' : 'border-gray-700 hover:border-gray-500' %> p-6 rounded-lg shadow-xl relative transition transform hover:-translate-y-1">
                        
                        <div class="flex justify-between items-center mb-4 pb-3 border-b border-gray-700">
                            <h3 class="text-xl font-bold text-white"><i class="fa-solid fa-folder-open text-gray-400 mr-2"></i>Slot <%= i + 1 %></h3>
                            <% if (slot) { %>
                                <span class="bg-yellow-600 text-white text-xs px-3 py-1 rounded shadow-sm font-bold">LV. <%= slot.level || 1 %></span>
                            <% } else { %>
                                <span class="text-gray-500 text-sm border border-gray-600 px-3 py-1 rounded">ว่างเปล่า</span>
                            <% } %>
                        </div>

                        <% if (slot) { %>
                            <div class="flex flex-col md:flex-row items-center gap-6">
                                
                                <div class="text-6xl bg-gray-900 p-4 rounded-full border border-gray-700 shadow-inner flex-shrink-0">
                                    <%= slot.avatar || '🧙' %>
                                </div>
                                
                                <div class="flex-1 text-center md:text-left w-full">
                                    <div class="text-2xl text-yellow-400 font-bold mb-3"><%= slot.username %></div>
                                    <div class="flex flex-wrap justify-center md:justify-start gap-2 mb-3">
                                        <span class="bg-red-900/40 text-red-200 text-sm px-2 py-1 rounded border border-red-800 font-mono">
                                            ❤️ HP <%= slot.hp %>/<%= slot.max_hp %>
                                        </span>
                                        <span class="bg-yellow-900/40 text-yellow-200 text-sm px-2 py-1 rounded border border-yellow-800 font-mono">
                                            💰 <%= slot.gold %> G
                                        </span>
                                        <span class="bg-blue-900/40 text-blue-200 text-sm px-2 py-1 rounded border border-blue-800 font-mono">
                                            📍 <%= slot.current_location || 'Village' %>
                                        </span>
                                    </div>
                                    <div class="text-gray-400 text-xs">
                                        <i class="fa-regular fa-clock mr-1"></i> บันทึกล่าสุด: <%= slot.saved_at ? new Date(slot.saved_at).toLocaleString('th-TH') : '—' %>
                                    </div>
                                </div>
                                
                                <div class="flex flex-col gap-2 w-full md:w-32 mt-4 md:mt-0">
                                    <form action="/game/load" method="POST" class="w-full m-0">
                                        <input type="hidden" name="slot" value="<%= i + 1 %>">
                                        <button type="submit" class="w-full bg-green-600 hover:bg-green-500 text-white font-bold py-2 rounded text-sm transition shadow"><i class="fa-solid fa-play mr-1"></i> โหลด</button>
                                    </form>
                                    <form action="/game/save" method="POST" class="w-full m-0">
                                        <input type="hidden" name="slot" value="<%= i + 1 %>">
                                        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-2 rounded text-sm transition shadow"><i class="fa-solid fa-file-arrow-down mr-1"></i> ทับ</button>
                                    </form>
                                    <form action="/game/delete-save" method="POST" class="w-full m-0" onsubmit="return confirm('ลบข้อมูล Slot <%= i+1 %> จริงหรือ?')">
                                        <input type="hidden" name="slot" value="<%= i + 1 %>">
                                        <button type="submit" class="w-full bg-red-700 hover:bg-red-600 text-white font-bold py-2 rounded text-sm transition shadow"><i class="fa-solid fa-trash mr-1"></i> ลบ</button>
                                    </form>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="flex flex-col md:flex-row items-center justify-between gap-4 py-2">
                                <span class="text-gray-500"><i class="fa-solid fa-ghost mr-2 opacity-50"></i> — ยังไม่มีข้อมูล —</span>
                                <form action="/game/save" method="POST" class="m-0">
                                    <input type="hidden" name="slot" value="<%= i + 1 %>">
                                    <button type="submit" class="bg-gray-700 hover:bg-gray-600 text-white font-bold py-2 px-6 rounded transition border border-gray-500 shadow"><i class="fa-solid fa-download mr-1"></i> บันทึกที่นี่</button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>

            <% if (typeof history !== 'undefined' && history && history.length > 0) { %>
                <div class="bg-dnd-panel border border-gray-700 rounded-lg shadow-xl overflow-hidden mt-8">
                    <div class="bg-gray-900/50 px-6 py-4 border-b border-gray-700">
                        <h3 class="text-xl font-bold text-gray-200"><i class="fa-solid fa-scroll mr-2"></i> 📜 ประวัติการเล่นล่าสุด</h3>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-black/20 text-gray-400 text-sm uppercase">
                                    <th class="p-4 border-b border-gray-700 font-semibold">วันที่</th>
                                    <th class="p-4 border-b border-gray-700 font-semibold text-center">คะแนน</th>
                                    <th class="p-4 border-b border-gray-700 font-semibold text-center">ถูก</th>
                                    <th class="p-4 border-b border-gray-700 font-semibold text-center">ผิด</th>
                                    <th class="p-4 border-b border-gray-700 font-semibold text-center">ผลลัพธ์</th>
                                </tr>
                            </thead>
                            <tbody class="text-sm">
                                <% history.slice(0, 10).forEach(h => { %>
                                <tr class="border-b border-gray-700/50 hover:bg-white/5 transition duration-150">
                                    <td class="p-4 text-gray-300 font-mono"><%= new Date(h.played_at).toLocaleDateString('th-TH') %></td>
                                    <td class="p-4 text-yellow-400 font-mono text-center font-bold text-base"><%= h.score || 0 %></td>
                                    <td class="p-4 text-green-400 font-mono text-center"><%= h.correct_answers || 0 %></td>
                                    <td class="p-4 text-red-400 font-mono text-center"><%= h.wrong_answers || 0 %></td>
                                    <td class="p-4 text-center">
                                        <span class="px-3 py-1 rounded text-xs font-bold <%= h.result === 'victory' ? 'bg-green-900/50 text-green-400 border border-green-700' : 'bg-red-900/50 text-red-400 border border-red-700' %>">
                                            <%= h.result === 'victory' ? 'ชนะ' : 'แพ้' %>
                                        </span>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>

            <div class="text-center mt-8 pb-8">
                <a href="/" class="inline-block bg-gray-800 hover:bg-gray-700 text-white font-bold py-3 px-8 rounded-md transition border border-gray-600 hover:border-gray-400 shadow-lg">
                    <i class="fa-solid fa-arrow-left mr-2"></i> กลับหน้าหลัก
                </a>
            </div>

        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('inventorySidebar');
            if (sidebar) {
                sidebar.classList.toggle('translate-x-full');
            }
        }
    </script>
</body>
</html>