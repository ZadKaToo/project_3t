<%- include('partials/header', { title: 'เข้าสู่ระบบ', hideNav: true }) %>

<div class="auth-page">
  <div class="auth-card animate-fadeinup">

    <div class="auth-header">
      <div class="auth-logo">⚔️</div>
      <div class="auth-title">Dungeon Scholar</div>
      <div class="auth-subtitle">เข้าสู่ดินแดนแห่งความรู้</div>
    </div>

    <div class="auth-body">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-error mb-md" style="padding: 10px; border: 1px solid var(--blood); background: rgba(139,26,26,0.1);">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <form action="/auth/login" method="POST">
        <div class="form-group">
          <label class="form-label" for="username">ชื่อผู้ใช้</label>
          <input class="form-input" type="text" id="username" name="username"
                 placeholder="กรอกชื่อผู้ใช้" autocomplete="username" required
                 value="<%= typeof formData !== 'undefined' ? formData.username || '' : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="password">รหัสผ่าน</label>
          <input class="form-input" type="password" id="password" name="password"
                 placeholder="กรอกรหัสผ่าน" autocomplete="current-password" required>
        </div>

        <button type="submit" class="btn btn--full btn--lg mt-md">
          🗡️ เข้าสู่ระบบ
        </button>
      </form>

      <div class="divider"></div>

      <div class="text-center">
        <a href="/auth/resetpassword" class="text-small text-dim">ลืมรหัสผ่าน?</a>
      </div>
    </div>

    <div class="auth-footer">
      ยังไม่มีบัญชี?
      <a href="/auth/register" class="text-gold">สมัครสมาชิก</a>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
