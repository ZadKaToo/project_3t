<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('partials/head') %>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&display=swap');

        /* แอนิเมชันละอองธุลี (Cinders) ลอยไปมา */
        @keyframes floatCinder {
            0% { transform: translateY(0) translateX(0) rotate(0deg); opacity: 0; }
            50% { opacity: 0.4; }
            100% { transform: translateY(-100vh) translateX(20px) rotate(360deg); opacity: 0; }
        }

        .cinder {
            position: absolute;
            background: #ff4500;
            width: 2px;
            height: 2px;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(1px);
            box-shadow: 0 0 5px #ff4500;
        }

        body {
            background: radial-gradient(circle, #1a161f 0%, #050505 100%);
            overflow: hidden;
            font-family: 'Cinzel', serif; /* หรือฟอนต์หัวข้ออื่นๆ ที่คุณมี */
        }

        .souls-panel {
            background: rgba(10, 10, 12, 0.9);
            border: 1px solid #2d2d2d;
            position: relative;
            box-shadow: 0 0 40px rgba(0, 0, 0, 0.9);
        }

        /* ตกแต่งกรอบสไตล์โลหะโบราณ */
        .souls-panel::before, .souls-panel::after {
            content: "";
            position: absolute;
            width: 50px;
            height: 50px;
            border: 1px solid #4a4030;
        }
        .souls-panel::before { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
        .souls-panel::after { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }

        .souls-input {
            background: rgba(0, 0, 0, 0.6) !important;
            border: 1px solid #3d3d3d !important;
            color: #d1d1d1 !important;
            transition: all 0.3s ease;
            letter-spacing: 1px;
        }

        .souls-input:focus {
            border-color: #8a7a5f !important;
            box-shadow: 0 0 10px rgba(138, 122, 95, 0.2);
            background: rgba(20, 20, 20, 0.8) !important;
        }

        .btn-souls {
            background: linear-gradient(180deg, #2d2d2d 0%, #1a1a1a 100%);
            border: 1px solid #4a4a4a;
            color: #a6a6a6;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 0.85rem;
            transition: all 0.4s ease;
        }

        .btn-souls:hover {
            border-color: #8a7a5f;
            color: #e3e3e3;
            background: #1f1f1f;
            box-shadow: 0 0 15px rgba(138, 122, 95, 0.3);
        }

        .souls-title {
            font-family: 'UnifrakturMaguntia', serif;
            letter-spacing: 5px;
            color: #f0f0f0;
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.1);
        }

        .souls-link {
            color: #5c5c5c;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: color 0.3s;
        }

        .souls-link:hover {
            color: #8a7a5f;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    
    <script>
        for (let i = 0; i < 30; i++) {
            let cinder = document.createElement('div');
            cinder.className = 'cinder';
            cinder.style.left = Math.random() * 100 + 'vw';
            cinder.style.top = Math.random() * 100 + 'vh';
            cinder.style.animation = `floatCinder ${5 + Math.random() * 10}s linear infinite`;
            cinder.style.animationDelay = Math.random() * 5 + 's';
            document.body.appendChild(cinder);
        }
    </script>

    <div class="souls-panel p-10 rounded-sm max-w-md w-full border border-gray-800 z-10">
        <div class="text-center mb-10">
            <h1 class="text-3xl font-bold souls-title mb-2 uppercase">Ashen One</h1>
            <div class="w-16 h-[1px] bg-gradient-to-r from-transparent via-[#4a4030] to-transparent mx-auto mb-4"></div>
            <p class="text-[10px] text-gray-600 tracking-[0.4em] uppercase">เข้าสู่ดินแดนต้องสาป</p>
        </div>
        
        <form action="/login" method="POST" class="space-y-6">
            <div class="relative">
                <label class="block text-[#5c5c5c] mb-2 text-[10px] uppercase tracking-widest">USERNAME</label>
                <input type="text" name="username" class="souls-input w-full rounded-sm px-4 py-3 focus:outline-none" required>
            </div>
            
            <div class="relative">
                <label class="block text-[#5c5c5c] mb-2 text-[10px] uppercase tracking-widest">PASSWORD</label>
                <input type="password" name="password" class="souls-input w-full rounded-sm px-4 py-3 focus:outline-none" required>
            </div>
            
            <div class="flex justify-between items-center">
                <a href="/register" class="souls-link">ลงทะเบียนใหม่?</a>
                <a href="/resetpassword" class="souls-link italic">ลืมรหัส?</a>
            </div>
            
            <button type="submit" class="btn-souls w-full py-4 rounded-sm transition-all flex justify-center items-center gap-3">
                เข้าสู่เกม
            </button>
        </form>
    </div>

    <div class="absolute bottom-6 opacity-20 pointer-events-none">
        <img src="https://www.transparenttextures.com/patterns/carbon-fibre.png" class="fixed inset-0 opacity-10">
        <p class="text-[9px] text-gray-500 tracking-[0.8em] uppercase italic">Thy strength befits a crown</p>
    </div>
</body>
</html>