<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen flex flex-col">
    <%- include('partials/header') %>

    <main class="flex-grow flex items-center justify-center p-6">
        <div class="bg-dnd-panel p-8 rounded-lg shadow-xl max-w-lg w-full border border-gray-700">
            <h2 class="text-2xl font-bold text-dnd-accent mb-6 border-b border-gray-600 pb-2">
                <i class="fa-solid fa-gear"></i> ตั้งค่า (Settings)
            </h2>
            
            <div class="space-y-6">
                <div>
                    <h3 class="text-white font-semibold mb-2">ระดับเสียง (Audio)</h3>
                    <div class="flex items-center space-x-4">
                        <i class="fa-solid fa-volume-low text-gray-400"></i>
                        <input type="range" id="volumeSlider" min="0" max="100" value="50" class="w-full accent-dnd-accent">
                        <i class="fa-solid fa-volume-high text-gray-400"></i>
                    </div>
                    <p class="text-sm text-gray-400 mt-1">ระดับเสียงปัจจุบัน: <span id="volumeLabel">50</span>%</p>
                </div>

                <div>
                    <h3 class="text-white font-semibold mb-2">เกมเพลย์ (Gameplay)</h3>
                    <label class="flex items-center space-x-3 text-gray-300 cursor-pointer">
                        <input type="checkbox" id="diceAnimToggle" checked class="form-checkbox h-5 w-5 text-dnd-accent bg-gray-900 border-gray-600 rounded">
                        <span>แสดงแอนิเมชันทอยลูกเต๋า (แสดงอยู่แล้วไม่ต้องปรับ)</span>
                    </label>
                    <label class="flex items-center space-x-3 text-gray-300 cursor-pointer mt-2">
                        <input type="checkbox" id="lowSpecToggle" class="form-checkbox h-5 w-5 text-dnd-accent bg-gray-900 border-gray-600 rounded">
                        <span>โหมดลดเอฟเฟกต์ (มีไว้เฉยๆ)</span>
                    </label>
                </div>

                <div class="pt-4 border-t border-gray-600 flex justify-end space-x-3">
                    <a href="/" class="px-4 py-2 bg-gray-700 hover:bg-gray-600 text-white rounded transition">ยกเลิก</a>
                    <button id="saveSettingsBtn" class="px-4 py-2 bg-green-600 hover:bg-green-500 text-white rounded font-bold transition">
                        <i class="fa-solid fa-save"></i> บันทึกการตั้งค่า
                    </button>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/notification') %> <script>
        document.addEventListener('DOMContentLoaded', () => {
            // อ้างอิง Elements
            const volumeSlider = document.getElementById('volumeSlider');
            const volumeLabel = document.getElementById('volumeLabel');
            const diceAnimToggle = document.getElementById('diceAnimToggle');
            const lowSpecToggle = document.getElementById('lowSpecToggle');
            const saveSettingsBtn = document.getElementById('saveSettingsBtn');

            // 1. โหลดการตั้งค่าเดิมจาก localStorage (ถ้ามี)
            const savedVolume = localStorage.getItem('game_volume');
            const savedDiceAnim = localStorage.getItem('game_dice_anim');
            const savedLowSpec = localStorage.getItem('game_low_spec');

            if (savedVolume !== null) {
                volumeSlider.value = savedVolume;
                volumeLabel.textContent = savedVolume;
            }
            if (savedDiceAnim !== null) {
                diceAnimToggle.checked = savedDiceAnim === 'true';
            }
            if (savedLowSpec !== null) {
                lowSpecToggle.checked = savedLowSpec === 'true';
            }

            // 2. อัปเดตตัวเลขเปอร์เซ็นต์แบบ Real-time เวลาเลื่อนแถบเสียง
            volumeSlider.addEventListener('input', (e) => {
                volumeLabel.textContent = e.target.value;
            });

            // 3. บันทึกการตั้งค่าเมื่อกดปุ่ม Save
            saveSettingsBtn.addEventListener('click', () => {
                localStorage.setItem('game_volume', volumeSlider.value);
                localStorage.setItem('game_dice_anim', diceAnimToggle.checked);
                localStorage.setItem('game_low_spec', lowSpecToggle.checked);

                // เปลี่ยนปุ่มเป็นสีเขียวสว่างเพื่อบอกว่าเซฟแล้ว
                const originalText = saveSettingsBtn.innerHTML;
                saveSettingsBtn.innerHTML = '<i class="fa-solid fa-check"></i> บันทึกสำเร็จ!';
                saveSettingsBtn.classList.replace('bg-green-600', 'bg-green-400');
                
                setTimeout(() => {
                    saveSettingsBtn.innerHTML = originalText;
                    saveSettingsBtn.classList.replace('bg-green-400', 'bg-green-600');
                    
                    // เด้งกลับหน้าหลักหลังเซฟเสร็จ
                    window.location.href = '/'; 
                }, 1000);
            });
        });
    </script>
</body>
</html>