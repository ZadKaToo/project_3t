<%- include('partials/header', { title: 'แผนที่', player: player }) %>

<div class="container--wide" style="padding-top: 32px; padding-bottom: 60px;">
  <div class="flex gap-lg" style="align-items: flex-start;">

    <!-- ===== SIDEBAR ===== -->
    <%- include('partials/hide-sidebar', {
      player: player,
      turnsLeft: typeof turnsLeft !== 'undefined' ? turnsLeft : '—',
      quickItems: typeof quickItems !== 'undefined' ? quickItems : []
    }) %>

    <!-- ===== MAIN MAP AREA ===== -->
    <div style="flex: 1; min-width: 0;">

      <!-- Header -->
      <div class="flex items-center justify-between mb-md animate-fadein">
        <div>
          <div class="section-label">World Map</div>
          <h2 style="margin: 0;">🗺️ แผนที่โลก</h2>
        </div>
        <div class="flex gap-sm items-center">
          <span class="badge badge--gold text-mono">รอบที่ <%= typeof currentTurn !== 'undefined' ? currentTurn : 1 %></span>
          <% if (typeof bossUnlocked !== 'undefined' && bossUnlocked) { %>
            <span class="badge badge--boss">⚠️ บอสปรากฏแล้ว!</span>
          <% } %>
        </div>
      </div>

      <!-- Map Grid + Legend -->
      <div class="panel panel--gold animate-fadeinup" style="margin-bottom: 16px;">
        <div class="panel-body" style="padding: 16px;">
          <div class="map-grid" id="mapGrid">
            <%
              const grid     = typeof mapGrid !== 'undefined' ? mapGrid : [];
              const playerPos = typeof playerPosition !== 'undefined' ? playerPosition : { row: 0, col: 0 };
            %>
            <% for (let r = 0; r < 5; r++) { %>
              <% for (let c = 0; c < 5; c++) { %>
                <%
                  const cell    = grid[r] && grid[r][c] ? grid[r][c] : {};
                  const isCur   = playerPos.row === r && playerPos.col === c;
                  const isVis   = cell.visited;
                  const icon    = cell.icon || '⬛';
                %>
                <div class="map-cell
                            <%= isCur ? 'map-cell--current' : '' %>
                            <%= !isCur && isVis ? 'map-cell--visited' : '' %>"
                     data-row="<%= r %>" data-col="<%= c %>"
                     title="<%= cell.name || 'Unknown' %>">
                  <%= isCur ? '🧙' : icon %>
                </div>
              <% } %>
            <% } %>
          </div>

          <!-- Legend -->
          <div class="flex gap-md flex-wrap mt-md" style="font-size: 12px; color: var(--parchment-dark);">
            <span>🌲 ป่า</span>
            <span>🏔️ ภูเขา</span>
            <span>🏰 เมือง</span>
            <span>⚔️ ดันเจี้ยน</span>
            <span>🧿 สถานที่ลับ</span>
            <span>💀 บอส</span>
          </div>
        </div>
      </div>

      <!-- ===== DICE ROLL ZONE ===== -->
      <div class="panel animate-fadeinup delay-1" style="margin-bottom: 16px;">
        <div class="panel-header">
          <span class="panel-title">🎲 ทอยลูกเต๋า</span>
          <span class="text-mono text-small" style="color: var(--gold-dim);">
            รอบที่เหลือ: <span id="turnsLeftDisplay"><%= typeof turnsLeft !== 'undefined' ? turnsLeft : '—' %></span>
          </span>
        </div>
        <div class="panel-body" style="text-align: center; padding: 24px;">
          <div id="diceDisplay" style="font-size: 72px; margin-bottom: 16px; line-height:1;">🎲</div>
          <div id="diceResult" class="text-mono mb-md" style="color: var(--gold-dim); min-height: 24px; font-size: 14px;"></div>

          <% if (typeof canRoll !== 'undefined' && !canRoll) { %>
            <!-- อยู่ในเหตุการณ์ที่ต้องจัดการก่อน -->
            <div class="text-danger text-mono text-small mb-md">⚠️ จัดการเหตุการณ์ก่อนทอยลูกเต๋า</div>
            <button class="btn btn--lg" disabled>🎲 ทอยลูกเต๋า</button>
          <% } else { %>
            <button class="btn btn--lg" id="rollBtn" onclick="rollDice()">🎲 ทอยลูกเต๋า</button>
          <% } %>
        </div>
      </div>

      <!-- ===== EVENT LOG ===== -->
      <div class="panel animate-fadeinup delay-2">
        <div class="panel-header">
          <span class="panel-title">📜 บันทึกเหตุการณ์</span>
          <button class="btn btn--sm btn--ghost" onclick="document.getElementById('eventLog').innerHTML=''">ล้าง</button>
        </div>
        <div class="panel-body" style="padding: 0;">
          <div class="event-log" id="eventLog">
            <% if (typeof eventLog !== 'undefined' && eventLog) { %>
              <% eventLog.forEach(entry => { %>
              <div class="log-entry log-entry--<%= entry.type || 'info' %>">
                <span class="text-mono" style="font-size:11px; color: var(--stone-lighter);">[<%= entry.time || '--:--' %>]</span>
                <%= entry.message %>
              </div>
              <% }) %>
            <% } else { %>
              <div class="log-entry log-entry--system">⚙️ ระบบพร้อมแล้ว กดทอยลูกเต๋าเพื่อเริ่มการผจญภัย</div>
            <% } %>
          </div>
        </div>
      </div>

    </div><!-- end main -->
  </div><!-- end flex -->
</div>

<script>
let isRolling = false;

async function rollDice() {
  if (isRolling) return;
  isRolling = true;

  const btn  = document.getElementById('rollBtn');
  const die  = document.getElementById('diceDisplay');
  const res  = document.getElementById('diceResult');
  const faces = ['⚀','⚁','⚂','⚃','⚄','⚅'];

  btn.disabled = true;
  die.classList.add('animate-dice');
  res.textContent = 'กำลังทอย...';

  // Animate shuffle
  let t = 0;
  const shuffleInterval = setInterval(() => {
    die.textContent = faces[Math.floor(Math.random() * 6)];
    t++;
    if (t >= 8) clearInterval(shuffleInterval);
  }, 80);

  setTimeout(async () => {
    try {
      const response = await fetch('/game/roll-dice', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await response.json();

      die.textContent = faces[data.roll - 1];
      die.classList.remove('animate-dice');
      res.textContent = `ได้ ${data.roll} — ${data.location || ''}`;

      addLog(data.message || `ทอยได้ ${data.roll}`, data.type || 'info');

      // Redirect ถ้าเจอ encounter
      if (data.redirect) {
        setTimeout(() => { window.location.href = data.redirect; }, 1000);
      } else {
        // Refresh map position
        setTimeout(() => window.location.reload(), 1200);
      }
    } catch (e) {
      res.textContent = 'เกิดข้อผิดพลาด';
      btn.disabled = false;
    }
    isRolling = false;
  }, 700);
}

function addLog(msg, type = 'info') {
  const log  = document.getElementById('eventLog');
  const now  = new Date().toLocaleTimeString('th-TH', { hour:'2-digit', minute:'2-digit' });
  const div  = document.createElement('div');
  div.className = `log-entry log-entry--${type} animate-fadein`;
  div.innerHTML = `<span class="text-mono" style="font-size:11px;color:var(--stone-lighter);">[${now}]</span> ${msg}`;
  log.prepend(div);
}
</script>

<%- include('partials/footer', { extraScript: 'map' }) %>
