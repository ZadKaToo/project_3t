<!DOCTYPE html>
<html lang="th">
<head>
    <%- include('partials/head') %>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-dnd-panel p-8 rounded-lg shadow-2xl max-w-md w-full border border-gray-700">
        <div class="text-center mb-8">
            <h2 class="text-2xl font-bold text-white">สร้างนักผจญภัยใหม่</h2>
        </div>
        
        <form action="/register" method="POST" class="space-y-4">
            <div>
                <label class="block text-gray-400 mb-1 text-sm">ชื่อนักผจญภัย (Username)</label>
                <input type="text" name="username" class="w-full bg-gray-900 text-white border border-gray-600 rounded px-4 py-2 focus:outline-none focus:border-dnd-accent" required>
            </div>
            <div>
                <label class="block text-gray-400 mb-1 text-sm">รหัสผ่าน (Password)</label>
                <input type="password" name="password" class="w-full bg-gray-900 text-white border border-gray-600 rounded px-4 py-2 focus:outline-none focus:border-dnd-accent" required>
            </div>
            <div>
                <label class="block text-gray-400 mb-1 text-sm">ยืนยันรหัสผ่าน (Confirm Password)</label>
                <input type="password" name="confirm_password" class="w-full bg-gray-900 text-white border border-gray-600 rounded px-4 py-2 focus:outline-none focus:border-dnd-accent" required>
            </div>
            <button type="submit" class="w-full bg-green-600 hover:bg-green-500 text-white font-bold py-2 rounded transition mt-4">
                ลงทะเบียน
            </button>
            <div class="text-center text-sm mt-4">
                <a href="/login" class="text-gray-400 hover:text-gray-300">มีบัญชีอยู่แล้ว? เข้าสู่ระบบ</a>
            </div>
        </form>
    </div>
</body>
</html>