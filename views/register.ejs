<%- include('partials/header', { title: 'สมัครสมาชิก', hideNav: true }) %>

<div class="auth-page">
  <div class="auth-card animate-fadeinup">

    <div class="auth-header">
      <div class="auth-logo">🧙</div>
      <div class="auth-title">สร้างตัวละคร</div>
      <div class="auth-subtitle">เริ่มต้นการผจญภัยของคุณ</div>
    </div>

    <div class="auth-body">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="form-error mb-md" style="padding: 10px; border: 1px solid var(--blood); background: rgba(139,26,26,0.1);">
          ⚠️ <%= error %>
        </div>
      <% } %>

      <form action="/auth/register" method="POST">

        <!-- เลือก Avatar -->
        <div class="form-group">
          <label class="form-label">เลือกตัวละคร</label>
          <div class="avatar-picker" id="avatarPicker">
            <% const avatars = ['🧙','🧝','🧛','🧟','🧜','🧚','🧞','🏹']; %>
            <% avatars.forEach((av, i) => { %>
            <button type="button" class="avatar-opt <%= i === 0 ? 'is-selected' : '' %>"
                    data-avatar="<%= av %>"><%= av %></button>
            <% }) %>
          </div>
          <input type="hidden" name="avatar" id="avatarInput" value="🧙">
        </div>

        <div class="form-group">
          <label class="form-label" for="username">ชื่อผู้ใช้</label>
          <input class="form-input" type="text" id="username" name="username"
                 placeholder="3–20 ตัวอักษร" required minlength="3" maxlength="20"
                 value="<%= typeof formData !== 'undefined' ? formData.username || '' : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="email">อีเมล</label>
          <input class="form-input" type="email" id="email" name="email"
                 placeholder="your@email.com" required
                 value="<%= typeof formData !== 'undefined' ? formData.email || '' : '' %>">
        </div>

        <div class="form-group">
          <label class="form-label" for="password">รหัสผ่าน</label>
          <input class="form-input" type="password" id="password" name="password"
                 placeholder="อย่างน้อย 6 ตัวอักษร" required minlength="6">
          <span class="form-hint">ควรมีตัวเลขและตัวอักษรปน</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="confirmPassword">ยืนยันรหัสผ่าน</label>
          <input class="form-input" type="password" id="confirmPassword" name="confirmPassword"
                 placeholder="กรอกรหัสผ่านอีกครั้ง" required>
          <span class="form-error" id="pwMatchErr" style="display:none;">รหัสผ่านไม่ตรงกัน</span>
        </div>

        <button type="submit" class="btn btn--full btn--lg mt-md" id="submitBtn">
          ⚔️ เริ่มการผจญภัย
        </button>
      </form>
    </div>

    <div class="auth-footer">
      มีบัญชีแล้ว?
      <a href="/auth/login" class="text-gold">เข้าสู่ระบบ</a>
    </div>

  </div>
</div>

<style>
.avatar-picker {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 4px;
}
.avatar-opt {
  font-size: 28px;
  width: 48px; height: 48px;
  border: 2px solid var(--stone-lighter);
  background: transparent;
  cursor: pointer;
  transition: var(--transition);
  display: flex; align-items: center; justify-content: center;
}
.avatar-opt:hover { border-color: var(--gold-dim); }
.avatar-opt.is-selected {
  border-color: var(--gold);
  background: rgba(201,168,76,0.15);
  box-shadow: 0 0 12px rgba(201,168,76,0.3);
}
</style>

<script>
  // Avatar picker
  document.querySelectorAll('.avatar-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.avatar-opt').forEach(b => b.classList.remove('is-selected'));
      btn.classList.add('is-selected');
      document.getElementById('avatarInput').value = btn.dataset.avatar;
    });
  });

  // Password match check
  const pw  = document.getElementById('password');
  const cpw = document.getElementById('confirmPassword');
  const err = document.getElementById('pwMatchErr');
  const sub = document.getElementById('submitBtn');
  cpw.addEventListener('input', () => {
    const mismatch = cpw.value && pw.value !== cpw.value;
    err.style.display = mismatch ? 'block' : 'none';
    sub.disabled = mismatch;
  });
</script>

<%- include('partials/footer') %>
