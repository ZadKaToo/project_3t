<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>ทอยเต๋าสุ่มอาชีพ</title>
    <style>
        .dice-container { text-align: center; margin-top: 50px; }
        .roll-btn { font-size: 24px; padding: 15px 30px; cursor: pointer; background-color: #ff5722; color: white; border: none; border-radius: 10px; }
        .roll-btn:hover { background-color: #e64a19; }
        #result { font-size: 28px; margin-top: 20px; font-weight: bold; color: #2e7d32; }
        #loading { display: none; font-size: 20px; color: #555; }
    </style>
</head>
<body>
    <div class="dice-container">
        <h1>🎲 โชคชะตาจะกำหนดเส้นทางของคุณ!</h1>
        <p>ทอยลูกเต๋าเพื่อสุ่มรับ 1 ใน 50 อาชีพสุดแกร่ง (หรือสุดกาก?)</p>
        
        <button id="rollButton" class="roll-btn" onclick="rollDice()">🎲 ทอยลูกเต๋าสุ่มอาชีพเลย!</button>
        
        <p id="loading">กำลังทอยลูกเต๋า... 🎲🎲🎲</p>
        <p id="result"></p>
        
        <button id="startGameBtn" style="display:none; margin-top:20px; padding: 10px 20px;" onclick="window.location.href='/map'">เข้าสู่เกม ⚔️</button>
    </div>

    <script>
        async function rollDice() {
            // ซ่อนปุ่ม ซ่อนผลลัพธ์ โชว์โหลด (ทำหลอกๆ ให้ดูตื่นเต้น)
            document.getElementById('rollButton').style.display = 'none';
            document.getElementById('loading').style.display = 'block';

            try {
                // ยิงไปที่ระบบหลังบ้านแบบไม่ต้องส่งข้อมูลอะไรไปเลย เพราะหลังบ้านสุ่มให้แล้ว
                const response = await fetch('/choose-class', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                const result = await response.json();

                // หน่วงเวลา 1.5 วินาทีให้คนลุ้น
                setTimeout(() => {
                    document.getElementById('loading').style.display = 'none';
                    
                    if (result.success) {
                        document.getElementById('result').innerText = result.message;
                        document.getElementById('startGameBtn').style.display = 'inline-block'; // โชว์ปุ่มเข้าเกม
                    } else {
                        document.getElementById('result').innerText = 'เกิดข้อผิดพลาด: ' + result.message;
                        document.getElementById('result').style.color = 'red';
                        document.getElementById('rollButton').style.display = 'inline-block'; // ให้กดใหม่ได้
                    }
                }, 1500); 

            } catch (error) {
                console.error('Error:', error);
                alert('ระบบขัดข้อง โปรดลองใหม่อีกครั้ง');
            }
        }
    </script>
</body>
</html>