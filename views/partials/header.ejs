<header class="bg-dnd-panel border-b border-gray-700 p-4 shadow-md relative z-[100]">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
        <a href="/" id="homeLogo" class="text-xl font-bold text-dnd-accent transition hover:text-white">
            <i class="fa-solid fa-dragon mr-2"></i>D&D Quiz RPG
        </a>
        
        <div class="flex space-x-6 text-sm md:text-base">
            <div class="text-green-400" title="พลังชีวิต">
                <i class="fa-solid fa-heart"></i> HP: <%= player.hp %>/<%= player.max_hp %>
            </div>
            <div class="text-dnd-sanity" title="ค่าสติ">
                <i class="fa-solid fa-brain"></i> Sanity: <%= player.sanity %>/<%= player.max_sanity %>
            </div>
            <div class="text-yellow-400" title="ทอง">
                <i class="fa-solid fa-coins"></i> Gold: <%= player.gold %>
            </div>
        </div>
        
        <div class="flex items-center">
            <span class="mr-4 text-white font-bold"><%= player.username %></span>
            
            <button id="inventoryBtn" onclick="toggleSidebar()" class="text-dnd-accent hover:text-white transition" title="กระเป๋าไอเทม">
                <i class="fa-solid fa-sack-dollar text-lg"></i>
            </button>
            
            <a href="/logout" class="text-red-400 hover:text-red-300 transition ml-12 border-l border-gray-700 pl-6" title="ออกจากระบบ">
                <i class="fa-solid fa-right-from-bracket text-lg"></i>
            </a>
        </div>
    </div>
</header>

<script>
    // 1. ฟังก์ชันสลับเปิด-ปิดกระเป๋า
    function toggleSidebar() {
        const sidebar = document.getElementById('inventorySidebar');
        if (sidebar) {
            sidebar.classList.toggle('translate-x-full');
        } else {
            console.error("❌ ไม่พบ Sidebar ในหน้านี้! ตรวจสอบว่าได้ include('partials/inventorySidebar') หรือยัง");
        }
    }

    // 2. ตรวจสอบเงื่อนไขหน้า Combat
    if (window.location.pathname.includes('/combat')) {
        // ล็อคปุ่ม Home
        const homeLogo = document.getElementById('homeLogo');
        if (homeLogo) {
            homeLogo.removeAttribute('href'); 
            homeLogo.classList.remove('hover:text-white');
            homeLogo.classList.add('cursor-not-allowed', 'opacity-70');
            homeLogo.onclick = (e) => e.preventDefault();
        }

        // 🔒 ล็อคปุ่มกระเป๋า
        const inventoryBtn = document.getElementById('inventoryBtn');
        if (inventoryBtn) {
            inventoryBtn.removeAttribute('onclick'); // ลบคำสั่งเปิดกระเป๋า
            inventoryBtn.classList.remove('hover:text-white', 'text-dnd-accent'); // เอาสีปกติออก
            inventoryBtn.classList.add('text-gray-600', 'cursor-not-allowed', 'opacity-70'); // เปลี่ยนเป็นสีเทาและเปลี่ยนเมาส์เป็นรูปห้ามกด
            inventoryBtn.title = "ไม่สามารถค้นกระเป๋าระหว่างต่อสู้ได้!"; // เปลี่ยนข้อความตอนเอาเมาส์ชี้
            inventoryBtn.onclick = (e) => e.preventDefault(); // กันเหนียวไม่ให้เกิด event ใดๆ
        }
    }
</script>

<% if (player && player.sanity <= (player.max_sanity * 0.3)) { %>
    <style>
        /* สร้างเอฟเฟกต์เบลอและขอบมืดแบบ Lovecraftian */
        body {
            animation: sanity-distort 4s infinite alternate ease-in-out;
            box-shadow: inset 0 0 150px rgba(75, 0, 130, 0.4); /* ขอบสีม่วงมืดๆ */
        }
        @keyframes sanity-distort {
            0% { filter: blur(0px) hue-rotate(0deg) contrast(1); transform: scale(1); }
            50% { filter: blur(1.5px) hue-rotate(-10deg) contrast(1.1); }
            100% { filter: blur(2.5px) hue-rotate(10deg) contrast(1.2); transform: scale(1.01); }
        }
        
        /* ทำสีข้อความให้ดูอันตรายขึ้นเล็กน้อย */
        .text-dnd-sanity {
            color: #ef4444 !important; /* เปลี่ยนตัวเลข Sanity เป็นสีแดงเตือนภัย */
            animation: pulse-red 2s infinite;
        }
        @keyframes pulse-red {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
    </style>
<% } %>