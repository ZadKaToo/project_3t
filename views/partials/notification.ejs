<%
  const _flashMsg  = typeof flash !== 'undefined' ? flash : null;
  const _flashType = typeof flashType !== 'undefined' ? flashType : '';
%>
<% if (_flashMsg) { %>
<div id="notif-toast"
     class="notification-toast <%= _flashType === 'danger' ? 'notification-toast--danger' : _flashType === 'success' ? 'notification-toast--success' : '' %>"
     role="alert">
  <%= _flashMsg %>
</div>
<script>
  (function () {
    const toast = document.getElementById('notif-toast');
    if (!toast) return;
    setTimeout(() => {
      toast.style.transition = 'opacity 0.5s ease';
      toast.style.opacity = '0';
      setTimeout(() => toast.remove(), 500);
    }, 3000);
  })();
</script>
<% } %>
