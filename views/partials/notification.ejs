<div id="notification-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2"></div>

<script>
    // ฟังก์ชันสำหรับเรียกใช้แจ้งเตือน
    // วิธีใช้: showNotification('บันทึกเกมสำเร็จ!', 'success');
    function showNotification(message, type = 'info') {
        const container = document.getElementById('notification-container');
        const notif = document.createElement('div');
        
        // กำหนดสีตามประเภท
        let bgColor = 'bg-gray-800 border-gray-600';
        let icon = '<i class="fa-solid fa-circle-info text-blue-400"></i>';
        
        if (type === 'success') {
            bgColor = 'bg-green-900/80 border-green-500';
            icon = '<i class="fa-solid fa-check-circle text-green-400"></i>';
        } else if (type === 'danger') {
            bgColor = 'bg-red-900/80 border-red-500';
            icon = '<i class="fa-solid fa-triangle-exclamation text-red-400"></i>';
        } else if (type === 'warning') {
            bgColor = 'bg-yellow-900/80 border-yellow-500';
            icon = '<i class="fa-solid fa-star text-yellow-400"></i>';
        }

        notif.className = `flex items-center gap-3 p-4 rounded-lg shadow-lg border text-white transform transition-all duration-300 translate-x-full ${bgColor}`;
        notif.innerHTML = `${icon} <span>${message}</span>`;

        container.appendChild(notif);

        // แอนิเมชันสไลด์เข้า
        setTimeout(() => {
            notif.classList.remove('translate-x-full');
        }, 10);

        // แอนิเมชันสไลด์ออกและลบ
        setTimeout(() => {
            notif.classList.add('translate-x-full');
            setTimeout(() => notif.remove(), 300);
        }, 3000);
    }
</script>