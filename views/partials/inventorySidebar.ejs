<div id="inventorySidebar" class="fixed inset-y-0 right-0 w-80 bg-dnd-panel border-l border-gray-600 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-50 flex flex-col">
    <div class="p-4 border-b border-gray-600 flex justify-between items-center bg-gray-900">
        <h3 class="text-xl font-bold text-dnd-accent"><i class="fa-solid fa-sack-dollar"></i> กระเป๋า & อุปกรณ์</h3>
        <button onclick="toggleSidebar()" class="text-gray-400 hover:text-white">
            <i class="fa-solid fa-xmark text-2xl"></i>
        </button>
    </div>

    <div class="px-4 py-3 bg-gray-800 border-b border-gray-700 flex items-center justify-between">
        <div>
            <p class="text-[10px] text-gray-500 uppercase font-bold tracking-wider">อาชีพปัจจุบัน</p>
            <h4 class="text-lg font-bold text-white"><%= (typeof player !== 'undefined') ? player.class_name : 'Novice' %></h4>
        </div>
        <div class="bg-dnd-accent/20 px-2 py-1 rounded border border-dnd-accent/50">
            <span class="text-dnd-accent text-xs font-bold"></span>
        </div>
    </div>

    <div class="p-4 bg-black/20 border-b border-gray-700">
        <p class="text-[10px] text-gray-500 uppercase mb-2 font-bold tracking-widest">อุปกรณ์ที่สวมใส่</p>
        <div class="grid grid-cols-2 gap-3">
            <div class="bg-gray-900/50 p-2 rounded border border-dashed border-gray-600 flex flex-col items-center justify-center min-h-[65px] text-center">
                <i class="fa-solid fa-sword text-gray-700 mb-1"></i>
                <span class="text-[9px] text-gray-500 block uppercase">อาวุธ</span>
                <span class="text-xs text-dnd-accent font-bold truncate w-full">
                    <%= (typeof equippedWeaponName !== 'undefined' && equippedWeaponName) ? equippedWeaponName : '---' %>
                </span>
            </div>
            <div class="bg-gray-900/50 p-2 rounded border border-dashed border-gray-600 flex flex-col items-center justify-center min-h-[65px] text-center">
                <i class="fa-solid fa-shield-halved text-gray-700 mb-1"></i>
                <span class="text-[9px] text-gray-500 block uppercase">เกราะ</span>
                <span class="text-xs text-blue-400 font-bold truncate w-full">
                    <%= (typeof equippedArmorName !== 'undefined' && equippedArmorName) ? equippedArmorName : '---' %>
                </span>
            </div>
        </div>
    </div>
    
    <div class="p-4 flex-grow overflow-y-auto space-y-3">
        <% if (typeof inventory !== 'undefined' && inventory.length > 0) { %>
            <% inventory.forEach(item => { 
                const isEquipped = (typeof player !== 'undefined') && (item.item_id == player.equipped_weapon || item.item_id == player.equipped_armor);

                let colorClass = 'bg-gray-900 border-gray-500 text-gray-400';
                let iconClass = 'fa-box';
                
                if(item.type === 'potion' || item.type === 'heal') {
                    colorClass = 'bg-red-900/50 border-red-500 text-red-400';
                    iconClass = 'fa-flask';
                } else if(item.type === 'helper' || item.type === 'scroll') {
                    colorClass = 'bg-purple-900/50 border-purple-500 text-purple-400';
                    iconClass = 'fa-scroll';
                } else if(item.type === 'weapon') {
                    colorClass = 'bg-gray-800 border-yellow-600/50 text-yellow-500';
                    iconClass = 'fa-sword';
                } else if(item.type === 'armor') {
                    colorClass = 'bg-blue-900/30 border-blue-500 text-blue-400';
                    iconClass = 'fa-shield-halved';
                }
            %>

            <div class="relative bg-gray-800 border <%= isEquipped ? 'border-yellow-500 shadow-[0_0_10px_rgba(234,179,8,0.3)] bg-gray-700' : 'border-gray-700' %> p-3 rounded flex items-center justify-between hover:border-gray-500 transition">
                
                <% if (isEquipped) { %>
                    <div class="absolute -top-2 -left-2 bg-yellow-500 text-black px-2 py-0.5 rounded text-[10px] font-bold shadow-md z-10">
                        <i class="fa-solid fa-check"></i> สวมใส่อยู่
                    </div>
                <% } %>

                <div class="flex items-center w-2/3 mt-1">
                    <div class="w-10 h-10 rounded flex items-center justify-center mr-3 border flex-shrink-0 <%= colorClass %>">
                        <i class="fa-solid <%= iconClass %>"></i>
                    </div>
                    <div>
                        <h4 class="text-white text-sm font-bold truncate <%= isEquipped ? 'text-yellow-400' : '' %>"><%= item.name %></h4>
                        <p class="text-xs text-gray-400 text-[10px]"><%= item.description %></p>
                    </div>
                </div>
                
                <div class="flex flex-col items-end justify-center w-1/3 mt-1 z-10">
                    <span class="text-gray-300 font-bold mb-1 text-sm">x<%= item.quantity %></span>
                    
                    <% if (item.type === 'heal' || item.type === 'potion') { %>
                        <button onclick="manageItem('<%= item.item_id %>', 'use')" class="bg-red-600 hover:bg-red-500 text-white px-2 py-1 rounded text-[10px] w-full text-center transition shadow-lg border border-red-400 cursor-pointer">
                            ใช้ (+<%= item.effect_value %>)
                        </button>
                    <% } %>
                    
                    <% if (item.type === 'weapon' || item.type === 'armor') { %>
                        <button onclick="manageItem('<%= item.item_id %>', 'equip')" 
                                class="<%= isEquipped ? 'bg-gray-600 hover:bg-gray-500 border-gray-400' : 'bg-blue-600 hover:bg-blue-500 border-blue-400' %> text-white px-2 py-1 rounded text-[10px] w-full text-center transition shadow-lg border cursor-pointer">
                            <%= isEquipped ? 'ถอดออก' : 'สวมใส่' %>
                        </button>
                    <% } %>
                </div>
            </div>
            <% }); %>
        <% } else { %>
            <div class="text-center text-gray-500 mt-10">
                <i class="fa-solid fa-box-open text-4xl mb-3"></i>
                <p>กระเป๋าว่างเปล่า</p>
            </div>
        <% } %>
    </div>
</div>

<script>
    async function manageItem(itemId, action) {
        // ถามยืนยันก่อนใช้งานหรือขาย (ถ้าอยากให้มี)
        if (action === 'use') {
            if (!confirm('ต้องการใช้งานไอเทมนี้ใช่หรือไม่?')) return;
        }

        try {
            // ส่งข้อมูลไปที่ Backend (แก้ URL ให้ตรงกับ Route ของคุณด้วยนะครับ เช่น /inventory/manage)
            const response = await fetch('/inventory/manage', { 
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ item_id: itemId, action: action })
            });

            const result = await response.json();

            if (result.success) {
                // ถ้าสำเร็จ ให้แจ้งเตือนและรีเฟรชหน้าเว็บ 1 รอบ เพื่ออัปเดตข้อมูลอาวุธ/เลือด ใน Sidebar
                alert(result.message);
                window.location.reload(); 
            } else {
                // ถ้าล้มเหลว (เช่น เลือดเต็มแล้ว, ไม่เจอไอเทม)
                alert('❌ ' + result.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('เกิดข้อผิดพลาดในการเชื่อมต่อกับเซิร์ฟเวอร์');
        }
    }
</script>